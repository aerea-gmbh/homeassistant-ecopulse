{
  "schemaVersion": 1,
  "apiVersion": 1,
  "basePath": "/api/ha/v1",
  "auth": {
    "header": "Authorization",
    "scheme": "Bearer",
    "realm": "ecopulse-ha",
    "tokenPrefix": "ecp_ha_",
    "tokenRandomBytes": 32,
    "tokenEncoding": "base64url",
    "hashAlgorithm": "sha256",
    "hashEncoding": "hex"
  },
  "scopes": [
    "read",
    "inputs",
    "control"
  ],
  "endpoints": [
    {
      "method": "GET",
      "path": "/info",
      "scope": "read"
    },
    {
      "method": "GET",
      "path": "/catalog",
      "scope": "read"
    },
    {
      "method": "GET",
      "path": "/stream",
      "scope": "read"
    }
  ],
  "reserved": {
    "endpoints": [
      {
        "method": "POST",
        "path": "/inputs",
        "scope": "inputs",
        "slice": "S5"
      },
      {
        "method": "POST",
        "path": "/control",
        "scope": "control",
        "slice": "S8"
      }
    ],
    "streamEvents": [
      "command"
    ]
  },
  "errors": [
    {
      "status": 401,
      "code": "unauthorized",
      "client": "reauth"
    },
    {
      "status": 403,
      "code": "insufficient_scope",
      "client": "reauth"
    },
    {
      "status": 404,
      "code": "not_found",
      "client": "retry-later"
    },
    {
      "status": 429,
      "code": "rate_limited",
      "client": "honour-retry-after"
    }
  ],
  "errorProperties": [
    "code",
    "message"
  ],
  "client": {
    "actions": [
      "reauth",
      "retry-later",
      "honour-retry-after"
    ],
    "retryLaterSeconds": 300,
    "backoffInitialSeconds": 1,
    "backoffMaxSeconds": 60,
    "onSnapshotRevisionMismatch": "refetch",
    "onUnknownValueId": "ignore"
  },
  "info": {
    "properties": [
      "apiVersion",
      "supportedApiVersions",
      "gatewayId",
      "gatewayName",
      "firmwareVersion",
      "catalogRevision",
      "scopes"
    ]
  },
  "catalog": {
    "properties": [
      "apiVersion",
      "catalogRevision",
      "gateway",
      "devices"
    ],
    "gatewayProperties": [
      "id",
      "name",
      "firmwareVersion"
    ],
    "deviceProperties": [
      "id",
      "name",
      "manufacturer",
      "model",
      "entities"
    ],
    "entityProperties": [
      "uniqueId",
      "name",
      "platform",
      "unit",
      "deviceClass",
      "stateClass",
      "suggestedDisplayPrecision",
      "entityCategory",
      "enabledByDefault"
    ],
    "nullableDeviceProperties": [
      "manufacturer",
      "model"
    ],
    "nullableEntityProperties": [
      "unit",
      "deviceClass",
      "stateClass",
      "suggestedDisplayPrecision",
      "entityCategory"
    ]
  },
  "stream": {
    "events": [
      "snapshot",
      "values",
      "availability",
      "catalog"
    ],
    "eventProperties": {
      "snapshot": [
        "catalogRevision",
        "devices",
        "values"
      ],
      "values": [
        "values"
      ],
      "availability": [
        "devices"
      ],
      "catalog": [
        "catalogRevision"
      ]
    },
    "valueProperties": [
      "id",
      "value",
      "ts"
    ],
    "availabilityProperties": [
      "id",
      "available"
    ],
    "heartbeatSeconds": 15,
    "clientDeadAfterSeconds": 45,
    "retryMilliseconds": 5000,
    "maxConcurrentStreams": 4,
    "overflowPolicy": "evict-oldest"
  },
  "vocabulary": {
    "platforms": [
      "sensor",
      "binary_sensor"
    ],
    "stateClasses": [
      "measurement",
      "total",
      "total_increasing"
    ],
    "entityCategories": [
      "diagnostic"
    ]
  },
  "configBlock": {
    "key": "homeAssistant",
    "properties": [
      "enabled",
      "gatewayName",
      "token",
      "devices"
    ],
    "tokenProperties": [
      "hash",
      "algorithm",
      "scopes"
    ],
    "deviceProperties": [
      "edgeEntityType",
      "edgeEntityId",
      "id",
      "name",
      "manufacturer",
      "model",
      "entities"
    ],
    "entityProperties": [
      "edgeIdentifier",
      "uniqueId",
      "name",
      "platform",
      "unit",
      "deviceClass",
      "stateClass",
      "suggestedDisplayPrecision",
      "entityCategory",
      "enabledByDefault"
    ],
    "omittedMeansNull": true,
    "localWriteKeepsStoredBlock": true
  },
  "zeroconf": {
    "serviceType": "_ecopulse._tcp.local.",
    "txtKeys": [
      "id",
      "api",
      "path"
    ]
  },
